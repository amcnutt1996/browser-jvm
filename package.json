{
  "name": "browser-jvm",
  "version": "1.0.0",
  "description": "A Java Virtual Machine written from scratch in TypeScript that runs .jar files in the browser, including libGDX games through WebGL2.",
  "keywords": [
    "java",
    "jvm",
    "jar",
    "interpreter",
    "jit",
    "webgl",
    "libgdx",
    "browser",
    "web-worker"
  ],
  "homepage": "https://github.com/amcnutt1996/browser-jvm#readme",
  "bugs": "https://github.com/amcnutt1996/browser-jvm/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amcnutt1996/browser-jvm.git"
  },
  "license": "MIT AND GPL-2.0-only WITH Classpath-exception-2.0",
  "author": "Gregory McNutt",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jvm/*": {
      "types": "./dist/jvm/*.d.ts",
      "default": "./dist/jvm/*.js"
    },
    "./gdx": {
      "types": "./dist/gdx/index.d.ts",
      "default": "./dist/gdx/index.js"
    },
    "./gdx/*": {
      "types": "./dist/gdx/*.d.ts",
      "default": "./dist/gdx/*.js"
    },
    "./jars/*": "./jars/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "jars",
    "src",
    "licenses",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:gdx": "node scripts/buildGdx.ts",
    "build:runtime": "node scripts/buildRuntime.ts",
    "conformance": "node scripts/conformance.ts",
    "lint": "oxlint --deny-warnings",
    "prepare": "npm run build",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "opentype.js": "^2.0.0",
    "pako": "^1.0.11"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/opentype.js": "^1.3.10",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18"
  }
}
